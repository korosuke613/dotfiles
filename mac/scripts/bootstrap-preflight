#!/usr/bin/env bash

set -euo pipefail

private_root="${DOTFILES_PRIVATE_HOME:-$HOME/.config/dotfiles/private}"
profile_file="${DOTFILES_PROFILE_FILE:-$HOME/.config/dotfiles/profiles}"

[[ -f "$profile_file" ]] || exit 0

while IFS= read -r profile; do
  [[ -z "$profile" || "$profile" == \#* ]] && continue
  [[ "$profile" =~ ^[A-Za-z0-9._-]+$ ]] || {
    printf 'preflight: invalid private profile name: %s\n' "$profile" >&2
    exit 1
  }

  role_dir="$private_root/profiles/$profile"
  [[ -d "$role_dir" ]] || {
    printf 'preflight: private profile is missing: %s\n' "$role_dir" >&2
    exit 1
  }

  recognized=0
  for file in zsh.zsh gitconfig claude-settings.json; do
    [[ -f "$role_dir/$file" ]] && recognized=1
  done
  [[ "$recognized" -eq 1 ]] || {
    printf 'preflight: private profile has no recognized overlay: %s\n' "$role_dir" >&2
    exit 1
  }

  if [[ -f "$role_dir/claude-settings.json" ]]; then
    plutil -convert xml1 -o /dev/null -- "$role_dir/claude-settings.json" || {
      printf 'preflight: invalid Claude settings JSON: %s\n' "$role_dir/claude-settings.json" >&2
      exit 1
    }
  fi
done < "$profile_file"
