#!/usr/bin/env bash

set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
link_mise_file() {
  local source="$1"
  local target="$2"
  local current_target="" backup
  if [[ -e "$target" || -L "$target" ]]; then
    [[ -L "$target" ]] && current_target=$(readlink "$target")
    if [[ "$current_target" != "$source" ]]; then
      backup="${target}.backup-$(date '+%Y%m%d%H%M%S')"
      mv "$target" "$backup"
      printf 'migration: backed up existing %s to %s\n' "$target" "$backup"
    fi
  fi
  ln -sfn "$source" "$target"
}

mkdir -p "$HOME/.config/mise"
link_mise_file "$repo_root/mise.toml" "$HOME/.config/mise/config.toml"
# mise はグローバル設定の lock を ~/.config/mise/mise.lock に書くので、リポジトリの lock に向ける
link_mise_file "$repo_root/mise.lock" "$HOME/.config/mise/mise.lock"

remove_legacy_link() {
  local target="$1"
  local expected="$2"
  if [[ -L "$target" && "$(readlink "$target")" == "$expected" ]]; then
    unlink "$target"
    printf 'migration: removed legacy link %s\n' "$target"
  elif [[ -e "$target" || -L "$target" ]]; then
    printf 'migration: leaving unrelated path untouched: %s\n' "$target" >&2
  fi
}

remove_legacy_link "$HOME/.asdfrc" "$repo_root/mac/asdf/.asdfrc"
remove_legacy_link "$HOME/.tool-versions" "$repo_root/mac/asdf/.tool-versions"
remove_legacy_link "$HOME/.tmux.conf" "$repo_root/mac/tmux/.tmux.conf"
