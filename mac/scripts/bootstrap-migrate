#!/usr/bin/env bash

set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
mise_config="$HOME/.config/mise/config.toml"

mkdir -p "$HOME/.config/mise"
if [[ -e "$mise_config" || -L "$mise_config" ]]; then
  current_target=""
  [[ -L "$mise_config" ]] && current_target=$(readlink "$mise_config")
  if [[ "$current_target" != "$repo_root/mise.toml" ]]; then
    backup="${mise_config}.backup-$(date '+%Y%m%d%H%M%S')"
    mv "$mise_config" "$backup"
    printf 'migration: backed up existing mise config to %s\n' "$backup"
  fi
fi
ln -sfn "$repo_root/mise.toml" "$mise_config"

remove_legacy_link() {
  local target="$1"
  local expected="$2"
  if [[ -L "$target" && "$(readlink "$target")" == "$expected" ]]; then
    unlink "$target"
    printf 'migration: removed legacy link %s\n' "$target"
  elif [[ -e "$target" || -L "$target" ]]; then
    printf 'migration: leaving unrelated path untouched: %s\n' "$target" >&2
  fi
}

remove_legacy_link "$HOME/.asdfrc" "$repo_root/mac/asdf/.asdfrc"
remove_legacy_link "$HOME/.tool-versions" "$repo_root/mac/asdf/.tool-versions"
remove_legacy_link "$HOME/.tmux.conf" "$repo_root/mac/tmux/.tmux.conf"

legacy_ghq_link="$HOME/ghq/dotfiles"
if [[ -L "$legacy_ghq_link" ]]; then
  resolved_ghq_target=$(cd "$legacy_ghq_link" 2>/dev/null && pwd -P || true)
  resolved_ghq_origin=""
  if [[ -n "$resolved_ghq_target" ]]; then
    resolved_ghq_origin=$(git -C "$resolved_ghq_target" remote get-url origin 2>/dev/null || true)
  fi
  case "$resolved_ghq_origin" in
    https://github.com/korosuke613/dotfiles|https://github.com/korosuke613/dotfiles.git|git@github.com:korosuke613/dotfiles.git)
      unlink "$legacy_ghq_link"
      printf 'migration: removed legacy ghq link %s\n' "$legacy_ghq_link"
      ;;
    *)
      printf 'migration: leaving unrelated ghq link untouched: %s\n' "$legacy_ghq_link" >&2
      ;;
  esac
fi
