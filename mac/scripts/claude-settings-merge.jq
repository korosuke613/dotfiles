# Three-way merge for ~/.claude/settings.json.
#
# Usage: jq -n --slurpfile base B --slurpfile new N --slurpfile live L \
#          --arg prefer live|sources -f this
#   base: the settings generated by the previous apply
#   new:  the settings generated from the current sources
#   live: ~/.claude/settings.json, which Claude Code also writes to
#
# With --arg first true there is no previous output yet: base is ignored and
# taken to be new restricted to the keys live already has. A differing live
# value is kept as a local change, and a key live lacks is added from new
# instead of being read as a local deletion.
#
# Objects are merged key by key; any other value (arrays included) is one
# leaf. Arrays under "permissions" are merged as sets instead, so rules
# approved in Claude Code and rules added to the sources can coexist.
# With prefer=sources every managed key (one in base or new) takes the value
# from new, so nothing conflicts; keys only Claude Code wrote are kept.
#
# Output: {result, conflicts: [{path, base, new, live}], overrides: [{path, new, live}]}
#   overrides lists managed keys whose live value is kept over the sources.

def missing: {"__claude_settings_merge_missing__": true};

def at($p):
  if ($p | length) == 0 then .
  elif type == "object" and has($p[0]) then .[$p[0]] | at($p[1:])
  else missing
  end;

def leaves:
  if type == "object" and length > 0 then
    to_entries[] | .key as $k | .value | leaves | [$k] + .
  else []
  end;

def as_array: if . == missing then [] else . end;

def set_merge($b; $n; $l):
  ($b | as_array) as $b | ($n | as_array) as $n | ($l | as_array) as $l
  | ($n + (($l - $b) - $n)) - ($b - $l);

def is_list: type == "array" or . == missing;

$new[0] as $n | $live[0] as $l
| (if $ARGS.named.first == "true" then
     reduce ($n | [leaves])[] as $p ({};
       if ($l | at($p)) != missing then setpath($p; $n | at($p)) else . end)
   else $base[0]
   end) as $b
| ([$b, $n, $l] | map([leaves]) | add | unique) as $paths
| reduce $paths[] as $p ({result: {}, conflicts: []};
    ($b | at($p)) as $bv | ($n | at($p)) as $nv | ($l | at($p)) as $lv
    | (if $lv == $bv or $lv == $nv then {value: $nv}
       elif $prefer == "sources" and ($nv != missing or $bv != missing) then {value: $nv}
       elif $nv == $bv then {value: $lv}
       elif $p[0] == "permissions" and ([$bv, $nv, $lv] | all(is_list)) then
         {value: set_merge($bv; $nv; $lv)}
       else {conflict: true}
       end) as $r
    | if $r.conflict then
        .conflicts += [{path: $p, base: $bv, new: $nv, live: $lv}]
      elif $r.value == missing then .
      else
        try (.result |= setpath($p; $r.value))
        catch (.conflicts += [{path: $p, base: $bv, new: $nv, live: $lv}])
      end)
| .result as $result
| .overrides = [
    $paths[] as $p
    | select(($n | at($p)) != missing or ($b | at($p)) != missing)
    | select(($result | at($p)) != ($n | at($p)))
    | {path: $p, new: ($n | at($p)), live: ($result | at($p))}
  ]
