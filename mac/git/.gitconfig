[user]
	name = Futa HIRAKOBA
	email = korosuke613613@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBQ9une2BjZT/F1aqINsSES6LtG1d0iLKo9pmElUI3aS korosuke613613@gmail.com

[core]
	autocrlf = input
	hookspath = 

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[init]
	defaultBranch = main
[credential]
	helper = osxkeychain
[pull]
	rebase = true
[push]
	autoSetupRemote = true 
[gpg]
	format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true
[credential "https://private-github.example.invalid"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential


# ~/.gitconfig — 既定（全 github.com リポ）は従来どおり gh の OAuth トークンを使う
[credential "https://github.com"]
    helper = !/opt/homebrew/bin/gh auth git-credential

[includeIf "gitdir:~/ghq/github.com/private-role/"]
    path = ~/.config/git/private-role.inc
# ~/.config/git/private-role.inc — private-role 配下でだけ読まれる

[includeIf "gitdir:~/ghq/private-github.example.invalid/"]
	path = ~/.config/git/office

# このPC固有・dotfiles管理外のローカル上書き（存在しないPCでは無視される）
[include]
	path = ~/.gitconfig.local
