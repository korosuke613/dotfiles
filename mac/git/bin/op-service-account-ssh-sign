#!/usr/bin/env bash
# git の gpg.ssh.program からssh-keygen -Y sign互換の引数で呼ばれる。
# 1Password SSH agent(Touch ID承認)を経由せず、Service Accountトークンで
# 秘密鍵を取り出し、ssh-keygenへそのまま委譲する。
set -euo pipefail

VAULT_ID="kx3cryzqjlp4bj57rdhq23hqly"
ITEM_REF="cl46pccjwa76olxcw2xrxau7tu"
KEYCHAIN_SERVICE="private-service-account"

# gitはgpg.ssh.programを署名時（-Y sign）だけでなく検証時（-Y verify等）にも呼ぶ。
# 検証時は-fにallowedSignersFileが渡ってくるため、秘密鍵への置き換えは署名時のみ行う。
if [[ "${1:-}" != "-Y" || "${2:-}" != "sign" ]]; then
  exec ssh-keygen "$@"
fi

tmp_key="$(mktemp)"
trap 'rm -f "$tmp_key"' EXIT
chmod 600 "$tmp_key"

OP_SERVICE_ACCOUNT_TOKEN="$(security find-generic-password -a "$USER" -s "$KEYCHAIN_SERVICE" -w)" \
  op read "op://REDACTED" >"$tmp_key"

args=("$@")
for i in "${!args[@]}"; do
  if [[ "${args[$i]}" == "-f" ]]; then
    args[$((i + 1))]="$tmp_key"
  fi
done

# gitは-Y sign時に-U（CA鍵をssh-agent経由で扱う指定）を付与してくるが、
# 本スクリプトは-fでファイルから直接秘密鍵を渡すため、-Uが付いたままだと
# ssh-keygenがssh-agentへ鍵を探しに行き「Couldn't find key in agent」で失敗する。
# そのため-Uフラグ自体を取り除く（後続の引数はメッセージファイルの位置引数のため残す）。
filtered_args=()
for a in "${args[@]}"; do
  if [[ "$a" == "-U" ]]; then
    continue
  fi
  filtered_args+=("$a")
done

exec ssh-keygen "${filtered_args[@]}"
