#!/usr/bin/env bash

set -euo pipefail

private_root="${DOTFILES_PRIVATE_HOME:-$HOME/.config/dotfiles/private}"
signer="$private_root/bin/op-service-account-ssh-sign"

if [[ ! -x "$signer" ]]; then
  printf 'dotfiles: private SSH signer is unavailable: %s\n' "$signer" >&2
  exit 1
fi

exec "$signer" "$@"
