{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "permissions": {
    "allow": [
      "mcp__github__get_file_contents",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__search_code",
      "mcp__github__search_issues",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:aws.amazon.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Skill(dev-standards:dev-standards)",
      "Skill(github:pr-respond)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run list:*)",
      "mcp__linear__get_issue",
      "mcp__linear__list_issues",
      "mcp__sharedoc__getConfluencePage",
      "mcp__aws-document__read_documentation",
      "mcp__aws-document__search_documentation",
      "Bash(pnpm list)",
      "Bash(pnpm list *)",
      "Bash(pnpm view *)",
      "Bash(pnpm info *)",
      "Bash(gh search *)",
      "WebFetch(domain:docs.github.com)",
      "Bash(pnpm build:github)",
      "WebFetch(domain:localhost)",
      "Bash(curl -sv http://localhost:3030/)",
      "Bash(curl -s http://127.0.0.1:3030/ -o /tmp/claude/slide_root.html -w \"HTTP %{http_code} size %{size_download}\\\\n\")",
      "Read(//tmp/claude/**)",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_take_screenshot",
      "WebFetch(domain:github.blog)"
    ],
    "defaultMode": "default"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.notification_type // \"unknown\"' | { read -r t; case \"$t\" in idle_prompt) msg='Claude Codeがユーザー＝サンの入力を待機している……';; permission_prompt) msg='Claude Codeが権限のユルシを求めている……';; elicitation_dialog) msg='Claude CodeがMCPの入力を求めている……';; *) exit 0;; esac; curl -s -d \"$msg\" ntfy.sh/REDACTED >/dev/null 2>&1 || true; }",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "git@korosuke613": true,
    "doc@korosuke613": true,
    "engineer@korosuke613": true,
    "security@korosuke613": true,
    "github@korosuke613": true,
    "dev-standards@korosuke613": true,
    "claude-md-management@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "ept@private-role": true
  },
  "extraKnownMarketplaces": {
    "private-role": {
      "source": {
        "source": "directory",
        "path": "~/ghq/github.com/private-role/ai-guide"
      }
    }
  },
  "outputStyle": "Explanatory",
  "language": "Japanese",
  "effortLevel": "medium",
  "advisorModel": "opus",
  "plansDirectory": "plans",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
